# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development

# Database Configuration
DATABASE_URL=postgresql://railway_user:railway_password@localhost:5432/railway_gate_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Train Data Provider
# Options: 'mock' or 'realapi'
TRAIN_DATA_PROVIDER=mock

# Real API Configuration (if using realapi provider)
# RAILWAY_API_KEY=your_api_key_here
# RAILWAY_API_BASE_URL=https://api.example.com
# RAILWAY_API_TIMEOUT=30

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# Feature Flags
GPS_UPDATE_INTERVAL=5000
TRAIN_UPDATE_INTERVAL=10000
NOTIFICATION_ENABLED=true
DEBUG_MODE=false

# Security
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# Geospatial
HAVERSINE_RADIUS_KM=6371
DEFAULT_SEARCH_RADIUS_KM=50
